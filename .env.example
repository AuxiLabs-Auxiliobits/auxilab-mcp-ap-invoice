# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Leave VISION_PROVIDER blank for local-only text extraction.
# Set it to gemini, anthropic, or openai when you want OCR/vision support.
VISION_PROVIDER=

# Optional vision provider keys.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_MODEL=gpt-4.1-mini

# Add other keys your tool requires below:
# DATABASE_URL=
